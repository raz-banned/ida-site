---
import BaseLayout from '../layouts/BaseLayout.astro';
import { samples } from '../data/samples';
---

<BaseLayout title="Попробовать бесплатно" description="Бесплатные медитации и материалы">
	<section class="intro">
		<h1>Попробовать бесплатно</h1>
		<p>Послушайте пример практики, чтобы понять, подходит ли вам этот формат.</p>
	</section>

	<div class="samples">
		{
			samples.map((sample) => (
				<article class="sample">
					<h2>{sample.title}</h2>
					<p class="meta">{sample.duration}</p>
					<p>{sample.description}</p>

					{sample.type === 'audio' ? (
						<audio controls preload="metadata" src={sample.src}>
							Ваш браузер не поддерживает воспроизведение аудио.
						</audio>
					) : (
						<div class="video">
							<iframe
								src={sample.embedUrl}
								title={sample.title}
								loading="lazy"
								allow="autoplay; fullscreen; picture-in-picture"
								allowfullscreen
							/>
						</div>
					)}
				</article>
			))
		}
	</div>

	<section class="cta">
		<p>Понравилось? В бандлах — полные практики и разговоры.</p>
		<a href="/bundles" class="button">Смотреть бандлы</a>
	</section>
</BaseLayout>

<style>
	.intro {
		text-align: center;
		margin-bottom: 3rem;
	}

	.intro p,
	.meta {
		color: var(--color-muted);
	}

	.samples {
		display: grid;
		gap: 1.5rem;
		max-width: 700px;
		margin: 0 auto 4rem;
	}

	.sample {
		background: white;
		border: 1px solid var(--color-border);
		border-radius: 12px;
		padding: 1.5rem;
	}

	.sample h2 {
		margin: 0;
	}

	.meta {
		margin-top: 0.2rem;
		font-size: 0.9rem;
	}

	audio {
		width: 100%;
	}

	.video {
		aspect-ratio: 16 / 9;
	}

	.video iframe {
		width: 100%;
		height: 100%;
		border: 0;
		border-radius: 8px;
	}

	.cta {
		text-align: center;
	}
</style>
